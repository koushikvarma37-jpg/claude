# Linux: run the Laya decision engine next to Motes.
#   pip install --user "laya[serve]"
#   cp deploy/systemd/laya.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now laya
[Unit]
Description=Laya decision engine for Motes
After=network-online.target
Before=motes.service

[Service]
ExecStart=%h/.local/bin/laya-serve
Restart=always
RestartSec=10
Environment=LAYA_HOST=127.0.0.1 LAYA_PORT=8000 LAYA_PRELOAD=1 LAYA_MODELS=english,multilingual
EnvironmentFile=-%h/.motes/env

[Install]
WantedBy=default.target
